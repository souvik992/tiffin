{
  "format": "tiffin-kot",
  "version": 1,
  "name": "Standard online order KOT",
  "description": "The channel and online order number on top, delivery or pickup, the customer.",
  "blocks": [
    {
      "type": "text",
      "text": "{{outlet.name}}",
      "align": "center",
      "bold": true
    },
    {
      "type": "text",
      "text": "ONLINE ORDER - KOT",
      "align": "center",
      "bold": true
    },
    {
      "type": "rule"
    },
    {
      "type": "kot-title",
      "align": "center",
      "bold": true
    },
    {
      "type": "text",
      "text": "{{order.channel}} {{online.no}}",
      "align": "center",
      "size": "big",
      "bold": true
    },
    {
      "type": "text",
      "text": "{{order.type}}",
      "align": "center",
      "bold": true
    },
    {
      "type": "text",
      "text": "TOKEN {{kot.token}}  {{kot.station}}",
      "align": "center"
    },
    {
      "type": "field",
      "label": "Customer",
      "value": "{{customer.name}}"
    },
    {
      "type": "field",
      "label": "Bill: {{order.no}}",
      "value": "{{kot.date}}"
    },
    {
      "type": "rule"
    },
    {
      "type": "items"
    },
    {
      "type": "text",
      "text": "Order note: {{order.note}}"
    },
    {
      "type": "rule"
    },
    {
      "type": "field",
      "label": "Items: {{kot.items}}",
      "value": "Qty: {{kot.qty}}"
    },
    {
      "type": "blank"
    },
    {
      "type": "text",
      "text": "** END **",
      "align": "center",
      "bold": true
    }
  ]
}
