{
  "format": "tiffin-receipt",
  "version": 1,
  "name": "Restaurant with GST table",
  "description": "Serial numbers and HSN on items, a GST summary table, a big token number and a UPI QR code to pay. Best on 80 mm paper.",
  "money": { "symbol": "Rs" },
  "blocks": [
    { "type": "text", "text": "{{outlet.name}}", "align": "center", "bold": true, "size": "wide" },
    { "type": "text", "text": "{{outlet.address}}", "align": "center" },
    { "type": "text", "text": "Phone {{outlet.phone}}", "align": "center" },
    { "type": "rule", "char": "=" },
    { "type": "doc-title" },
    { "type": "text", "text": "TOKEN {{invoice.token}}", "align": "center", "bold": true, "size": "big", "if": "invoice.token" },
    { "type": "rule", "char": "=" },
    { "type": "field", "label": "Bill No", "value": "{{invoice.no}}" },
    { "type": "field", "label": "Date", "value": "{{invoice.date-only}}" },
    { "type": "field", "label": "Time", "value": "{{invoice.time}}" },
    { "type": "field", "label": "Original bill", "value": "{{invoice.against}}" },
    { "type": "field", "label": "Customer GSTIN", "value": "{{invoice.buyer-gstin}}" },
    { "type": "field", "label": "Served by", "value": "{{cashier.name}}" },
    { "type": "rule" },
    { "type": "items", "columns": [
      { "field": "sno", "label": "#" },
      { "field": "name", "label": "Item", "width": "*" },
      { "field": "hsn", "label": "HSN" },
      { "field": "qty", "label": "Qty" },
      { "field": "amount", "label": "Amount" }
    ] },
    { "type": "rule" },
    { "type": "totals", "rows": [{ "row": "subtotal", "label": "Item total" }, "discount", "roundoff"] },
    { "type": "grand-total", "label": "NET PAYABLE", "refundLabel": "REFUND AMOUNT" },
    { "type": "rule" },
    { "type": "text", "text": "GST summary (included in prices)", "bold": true },
    { "type": "tax-table" },
    { "type": "totals", "rows": ["tax-total"] },
    { "type": "rule" },
    { "type": "payments" },
    { "type": "rule" },
    { "type": "text", "text": "Scan to pay by UPI", "align": "center" },
    { "type": "qr", "data": "upi", "size": 5 },
    { "type": "text", "text": "GSTIN {{outlet.gstin}}", "align": "center" },
    { "type": "text", "text": "FSSAI Lic. No. {{outlet.fssai}}", "align": "center" },
    { "type": "footer", "bold": true }
  ]
}
