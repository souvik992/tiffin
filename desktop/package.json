{
  "name": "tiffin-pos-desktop",
  "version": "0.3.13",
  "private": true,
  "description": "Windows desktop app for the offline-first POS: Electron host around the backend and the React UI.",
  "author": "Tiffin POS",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && node scripts/electron.mjs .",
    "icon": "node scripts/electron.mjs scripts/make-icon.cjs",
    "test": "node --test test/protocol.test.ts",
    "typecheck": "tsc -p .",
    "dist": "node scripts/build.mjs && electron-builder --win --config electron-builder.config.cjs",
    "dist:dir": "node scripts/build.mjs && electron-builder --win dir --config electron-builder.config.cjs",
    "test:e2e": "node scripts/build.mjs && node --test test/app.e2e.test.ts",
    "test:e2e:shop": "node scripts/build.mjs && npm run build --prefix ../addons/ods && node --test test/shop.e2e.test.ts",
    "start:manager": "node scripts/build-manager.mjs && node scripts/electron.mjs dist-manager/main.cjs",
    "dist:manager": "node scripts/build-manager.mjs && electron-builder --win --config electron-builder.manager.cjs",
    "test:e2e:manager": "node scripts/build-manager.mjs && node --test test/manager.e2e.test.ts",
    "icon:manager": "node -e \"process.env.ICON_LETTER='D';process.env.ICON_BG='oklch(35% .06 50)';process.env.ICON_OUT='manager-icon.png';require('child_process').spawnSync(process.execPath,['scripts/electron.mjs','scripts/make-icon.cjs'],{stdio:'inherit',env:process.env})\""
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.8.3"
  }
}
